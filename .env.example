# Salin file ini menjadi .env lalu sesuaikan kebutuhan.

# Port server
PORT=3000

# Path binary (kosongkan = cari di PATH sistem)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Konteks client PO Token. Umumnya: web.gvs | mweb.gvs | ios.gvs
PO_CLIENT=web.gvs

# Token dianggap kedaluwarsa setelah N menit (dibuat ulang otomatis)
PO_TOKEN_TTL_MINUTES=20

# yt-dlp: lewati permintaan halaman web saat visitor_data eksternal dipakai.
# Kosongkan (PLAYER_SKIP=) untuk memakai perilaku default yt-dlp.
PLAYER_SKIP=webpage,configs

# Jumlah job konversi yang boleh berjalan bersamaan
MAX_CONCURRENT_JOBS=3

# Batas permintaan per IP per menit
RATE_LIMIT_INFO=20
RATE_LIMIT_JOBS=8

# Opsional: pakai proxy untuk akses YouTube (mis. server kena blokir)
# HTTPS_PROXY=http://127.0.0.1:8888
